{
  "name": "tvbox-pc",
  "productName": "TVBox PC",
  "version": "2.9.12",
  "description": "TVBox 电脑版：基于 TVBox 开源接口协议实现的桌面影视播放客户端（空壳播放器，不含任何影视资源）",
  "main": "src/main.js",
  "author": "TVBox PC",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64",
    "setup": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tvbox.pc",
    "productName": "TVBox PC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TVBox-PC-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TVBox PC",
      "uninstallDisplayName": "TVBox PC ${version}",
      "deleteAppDataOnUninstall": false,
      "artifactName": "TVBox-PC-${version}-setup.exe"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "TVBox 桌面客户端空壳播放器",
      "artifactName": "TVBox-PC-${version}-${arch}.tar.gz"
    }
  }
}
